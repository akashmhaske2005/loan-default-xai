# LoanXAI Backend — Environment Configuration
# ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control (it contains secrets).

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank (or remove) to use SQLite (default, no setup required)
# DATABASE_URL=

# PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/loanxai

# Hosted PostgreSQL examples:
#   Supabase:   DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
#   Railway:    DATABASE_URL=postgresql://postgres:[password]@[host].railway.app:5432/railway
#   AWS RDS:    DATABASE_URL=postgresql://[user]:[password]@[rds-endpoint]:5432/loanxai
#   Neon (free):DATABASE_URL=postgresql://[user]:[password]@[host].neon.tech/loanxai?sslmode=require

# ── Flask ─────────────────────────────────────────────────────────────────────
# FLASK_ENV=development
# SECRET_KEY=change-this-to-a-long-random-string-in-production
